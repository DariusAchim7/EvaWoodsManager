@using EvaWoods.Application.Proiecte
@inject IProiectService ProiectService

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_model.Etaj" Label="Etaj" />
        <MudSelect T="bool?" @bind-Value="_model.AreLift" Label="Lift disponibil" Clearable="true" Class="mt-3">
            <MudSelectItem T="bool?" Value="true">Da</MudSelectItem>
            <MudSelectItem T="bool?" Value="false">Nu</MudSelectItem>
        </MudSelect>
        <MudTextField @bind-Value="_model.AccesAuto" Label="Acces auto" Class="mt-3" />
        <MudTextField @bind-Value="_model.LocParcare" Label="Loc de parcare" Class="mt-3" />
        <MudTextField @bind-Value="_model.PersoanaContactMontaj" Label="Persoană de contact" Class="mt-3" />
        <MudTextField @bind-Value="_model.IntervalOrarPreferat" Label="Interval orar preferat" Class="mt-3" />
        <MudTextField @bind-Value="_model.ObservatiiTransport" Label="Observații transport" Lines="2" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Anuleaza">Anulează</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Salveaza" Disabled="_seSalveaza">Salvează</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ProiectDto Proiect { get; set; } = default!;

    private bool _seSalveaza;
    private readonly ModelDateMontaj _model = new();

    protected override void OnInitialized()
    {
        _model.Etaj = Proiect.Etaj;
        _model.AreLift = Proiect.AreLift;
        _model.AccesAuto = Proiect.AccesAuto;
        _model.LocParcare = Proiect.LocParcare;
        _model.PersoanaContactMontaj = Proiect.PersoanaContactMontaj;
        _model.IntervalOrarPreferat = Proiect.IntervalOrarPreferat;
        _model.ObservatiiTransport = Proiect.ObservatiiTransport;
    }

    private async Task Salveaza()
    {
        _seSalveaza = true;

        await ProiectService.ActualizeazaDateMontajAsync(new ActualizeazaDateMontajRequest(
            ProiectId: Proiect.Id,
            Etaj: _model.Etaj,
            AreLift: _model.AreLift,
            AccesAuto: _model.AccesAuto,
            LocParcare: _model.LocParcare,
            PersoanaContactMontaj: _model.PersoanaContactMontaj,
            IntervalOrarPreferat: _model.IntervalOrarPreferat,
            ObservatiiTransport: _model.ObservatiiTransport));

        _seSalveaza = false;
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Anuleaza() => MudDialog.Cancel();

    private class ModelDateMontaj
    {
        public string? Etaj { get; set; }
        public bool? AreLift { get; set; }
        public string? AccesAuto { get; set; }
        public string? LocParcare { get; set; }
        public string? PersoanaContactMontaj { get; set; }
        public string? IntervalOrarPreferat { get; set; }
        public string? ObservatiiTransport { get; set; }
    }
}
