@page "/proiecte"
@using EvaWoods.Application.Proiecte
@using EvaWoods.Domain.Proiecte
@using EvaWoods.Web.Components.Shared
@using Microsoft.AspNetCore.Components
@inject IProiectService ProiectService
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<PageTitle>Proiecte</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Proiecte</MudText>
<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
    Gestionează toate proiectele de mobilier, de la ofertare până la montaj.
</MudText>

@if (!_seIncarca)
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Title="Proiecte active" Value="@ProiecteActive.ToString()" Icon="@Icons.Material.Filled.Groups" Color="Color.Primary" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Title="Oferte în lucru" Value="@OferteInLucru.ToString()" Icon="@Icons.Material.Filled.Description" Color="Color.Warning" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Title="Montaje programate" Value="@MontajeProgramate.ToString()" Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Info" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Title="Valoare totală" Value="@ValoareTotalaFormatata" Subtitle="lei" Icon="@Icons.Material.Filled.Payments" Color="Color.Success" />
        </MudItem>
    </MudGrid>
}

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h6">Proiecte (@(_proiecte?.Count ?? 0))</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="DeschideDialogAdaugaProiect">
        Adaugă proiect
    </MudButton>
</MudStack>

<MudGrid>
    <MudItem xs="12" md="8">
        @if (_seIncarca)
        {
            <MudProgressCircular Indeterminate="true" Class="my-8" />
        }
        else if (_proiecte is { Count: 0 })
        {
            <MudAlert Severity="Severity.Info">Nu ai încă niciun proiect. Adaugă primul proiect folosind butonul de mai sus.</MudAlert>
        }
        else
        {
            <MudTable Items="@_proiecte" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" T="ProiectDto"
                      OnRowClick="@((TableRowClickEventArgs<ProiectDto> e) => SelecteazaProiect(e.Item))">
                <HeaderContent>
                    <MudTh>Proiect</MudTh>
                    <MudTh>Client</MudTh>
                    <MudTh>Cod</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Valoare</MudTh>
                    <MudTh>Termen limită</MudTh>
                    <MudTh>Progres</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Proiect">
                        <MudText Typo="Typo.body1">@context.Nume</MudText>
                        @if (!string.IsNullOrWhiteSpace(context.Subtip))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Subtip</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Client">
                        <MudText Typo="Typo.body2">@context.ClientNume</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.ClientLocalitate</MudText>
                    </MudTd>
                    <MudTd DataLabel="Cod">@context.CodProiect</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="@CuloareStatus(context.Status)" Size="Size.Small">@NumeStatus(context.Status)</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Valoare">@FormateazaLei(context.Valoare)</MudTd>
                    <MudTd DataLabel="Termen limită">
                        <div>@FormateazaData(context.TermenLimita)</div>
                        @if (context.TermenLimita.HasValue)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@ZileRamase(context.TermenLimita.Value)</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Progres">@(context.Progres)%</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudItem>

    <MudItem xs="12" md="4">
        @if (_proiectSelectat is null)
        {
            <MudPaper Class="pa-6 d-flex flex-column align-center justify-center"
                      Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default); height: 100%; min-height: 300px;">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Class="mb-2 mud-text-secondary" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary" Align="Align.Center">
                    Selectează un proiect din listă pentru a vedea detaliile.
                </MudText>
            </MudPaper>
        }
        else
        {
            <MudPaper Class="pa-4" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudAvatar Color="Color.Primary" Size="Size.Large" Variant="Variant.Filled" Style="border-radius: 8px;">
                        @Initiale(_proiectSelectat.Nume)
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">@_proiectSelectat.Nume</MudText>
                        <MudChip T="string" Color="@CuloareStatus(_proiectSelectat.Status)" Size="Size.Small">@NumeStatus(_proiectSelectat.Status)</MudChip>
                    </MudStack>
                </MudStack>

                <MudStack Spacing="1" Class="mb-3">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mud-text-secondary" />
                        <MudText Typo="Typo.body2">@_proiectSelectat.ClientNume</MudText>
                    </MudStack>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="mud-text-secondary" />
                        <MudText Typo="Typo.body2">@_proiectSelectat.ClientLocalitate</MudText>
                    </MudStack>
                </MudStack>

                <MudDivider Class="mb-3" />

                <MudGrid Class="mb-3">
                    <MudItem xs="4">
                        <MudText Typo="Typo.subtitle1">@FormateazaLei(_proiectSelectat.Valoare)</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Valoare</MudText>
                    </MudItem>
                    <MudItem xs="4">
                        <MudText Typo="Typo.subtitle1">@FormateazaData(_proiectSelectat.TermenLimita)</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Termen limită</MudText>
                    </MudItem>
                    <MudItem xs="4">
                        <MudText Typo="Typo.subtitle1">@(_proiectSelectat.Progres)%</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Progres</MudText>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="mb-3" />

                <MudText Typo="Typo.subtitle2" Class="mb-1">Notițe rapide</MudText>
                <MudTextField T="string" @bind-Value="_notaText" Lines="3" Variant="Variant.Outlined"
                              Placeholder="Adaugă o notă despre acest proiect..." />
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-1"
                           OnClick="SalveazaNota" Disabled="_seSalveazaNota">
                    Salvează notă
                </MudButton>

                <MudDivider Class="my-3" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="VeziDetalii">
                    Vezi detalii
                </MudButton>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    private List<ProiectDto>? _proiecte;
    private bool _seIncarca = true;

    private ProiectDto? _proiectSelectat;
    private string _notaText = string.Empty;
    private bool _seSalveazaNota;

    protected override async Task OnInitializedAsync()
    {
        _proiecte = (await ProiectService.ObtineListaProiecteAsync()).ToList();
        _seIncarca = false;
    }

    private async Task DeschideDialogAdaugaProiect()
    {
        var dialog = await DialogService.ShowAsync<AdaugaProiectDialog>("Adaugă proiect");
        var rezultat = await dialog.Result;

        if (rezultat is { Canceled: false })
        {
            _proiecte = (await ProiectService.ObtineListaProiecteAsync()).ToList();
        }
    }

    private void SelecteazaProiect(ProiectDto proiect)
    {
        _proiectSelectat = proiect;
        _notaText = proiect.Note ?? string.Empty;
    }

    private async Task SalveazaNota()
    {
        if (_proiectSelectat is null) return;

        _seSalveazaNota = true;
        await ProiectService.AdaugaNotaAsync(_proiectSelectat.Id, _notaText);
        _seSalveazaNota = false;
    }

    private void VeziDetalii()
    {
        if (_proiectSelectat is null) return;
        NavigationManager.NavigateTo($"/proiecte/{_proiectSelectat.Id}");
    }

    private int ProiecteActive => _proiecte?.Count(p => p.Status != StatusProiect.Finalizat) ?? 0;

    private int OferteInLucru => _proiecte?.Count(p =>
        p.Status is StatusProiect.OfertaTrimisa or StatusProiect.Masuratori or StatusProiect.Proiectare) ?? 0;

    private int MontajeProgramate => _proiecte?.Count(p => p.Status == StatusProiect.LaMontaj) ?? 0;

    private decimal ValoareTotala => _proiecte?.Where(p => p.Status != StatusProiect.Finalizat).Sum(p => p.Valoare) ?? 0;

    private string ValoareTotalaFormatata => $"{ValoareTotala:N0}";

    private static string FormateazaLei(decimal valoare) => $"{valoare:N0} lei";

    private static string FormateazaData(DateTime? data) => data?.ToString("dd MMM yyyy") ?? "-";

    private static string Initiale(string nume)
    {
        var parti = nume.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parti.Length switch
        {
            0 => "?",
            1 => parti[0][..Math.Min(2, parti[0].Length)].ToUpperInvariant(),
            _ => $"{parti[0][0]}{parti[^1][0]}".ToUpperInvariant()
        };
    }

    private static string ZileRamase(DateTime termen)
    {
        var zile = (termen.Date - DateTime.Today).Days;
        return zile switch
        {
            0 => "azi",
            1 => "mâine",
            < 0 => $"depășit cu {-zile} zile",
            _ => $"în {zile} zile"
        };
    }

    private static Color CuloareStatus(StatusProiect status) => status switch
    {
        StatusProiect.OfertaTrimisa => Color.Info,
        StatusProiect.Masuratori => Color.Warning,
        StatusProiect.Proiectare => Color.Info,
        StatusProiect.InProductie => Color.Warning,
        StatusProiect.LaMontaj => Color.Primary,
        StatusProiect.Finalizat => Color.Success,
        _ => Color.Default
    };

    private static string NumeStatus(StatusProiect status) => status switch
    {
        StatusProiect.OfertaTrimisa => "Ofertă trimisă",
        StatusProiect.Masuratori => "Măsurători",
        StatusProiect.Proiectare => "Proiectare",
        StatusProiect.InProductie => "În producție",
        StatusProiect.LaMontaj => "La montaj",
        StatusProiect.Finalizat => "Finalizat",
        _ => status.ToString()
    };
}
