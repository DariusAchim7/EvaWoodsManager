@using EvaWoods.Application.Proiecte
@inject IProiectService ProiectService

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_descriere" Label="Descriere pas următor" Lines="2" />
        <MudDatePicker @bind-Date="_termen" Label="Termen (opțional)" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Anuleaza">Anulează</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Salveaza" Disabled="_seSalveaza">Salvează</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid ProiectId { get; set; }
    [Parameter] public string? DescriereActuala { get; set; }
    [Parameter] public DateTime? TermenActual { get; set; }

    private bool _seSalveaza;
    private string? _descriere;
    private DateTime? _termen;

    protected override void OnInitialized()
    {
        _descriere = DescriereActuala;
        _termen = TermenActual;
    }

    private async Task Salveaza()
    {
        _seSalveaza = true;
        await ProiectService.SeteazaUrmatorulPasAsync(ProiectId, _descriere, _termen);
        _seSalveaza = false;
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Anuleaza() => MudDialog.Cancel();
}
