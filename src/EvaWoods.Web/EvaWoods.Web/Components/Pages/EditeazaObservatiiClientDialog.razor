@using EvaWoods.Application.Proiecte
@inject IProiectService ProiectService

<MudDialog>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_observatii" Label="Observații client" Lines="5" Variant="Variant.Outlined"
                      Placeholder="Preferințe, cerințe, buget, culori dorite etc." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Anuleaza">Anulează</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Salveaza">Salvează</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string? ObservatiiActuale { get; set; }

    private string _observatii = string.Empty;

    protected override void OnInitialized()
    {
        _observatii = ObservatiiActuale ?? string.Empty;
    }

    private void Salveaza() => MudDialog.Close(DialogResult.Ok(_observatii));
    private void Anuleaza() => MudDialog.Cancel();
}
