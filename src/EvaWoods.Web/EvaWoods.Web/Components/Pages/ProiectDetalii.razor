    private (string Text, Color Culoare) InfoTermenLimita()
    {
        if (_proiect?.TermenLimita is null)
            return ("Fără termen limită setat", Color.Default);

        var zile = (_proiect.TermenLimita.Value.Date - DateTime.Today).Days;

        if (zile < 0)
            return ($"Termen depășit cu {-zile} zile", Color.Error);
        if (zile <= 7)
            return ($"Mai sunt {zile} zile", Color.Warning);

        return ($"Mai sunt {zile} zile", Color.Success);
    }

