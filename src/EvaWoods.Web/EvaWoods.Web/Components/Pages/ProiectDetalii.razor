    private record GrupCant(string Nume, decimal NecesarMl, decimal OfertaMl, decimal? PretUnitar, decimal? Total);

    private List<GrupCant> GrupuriCant
    {
        get
        {
            return (_piese ?? new List<PiesaDto>())
                .Where(p => p.TotalCantMl > 0)
                .GroupBy(p => new { p.MaterialCantProdusId, Nume = p.MaterialCantNume ?? "Fără material cant" })
                .Select(g =>
                {
                    var necesar = g.Sum(p => p.TotalCantMl);
                    var oferta = Math.Ceiling(necesar * 1.05m / 5m) * 5m;
                    decimal? pret = null;
                    if (g.Key.MaterialCantProdusId.HasValue &&
                        _produseCatalog.TryGetValue(g.Key.MaterialCantProdusId.Value, out var produs))
                    {
                        pret = produs.PretCalcul ?? produs.PretAchizitie;
                    }
                    return new GrupCant(g.Key.Nume, necesar, oferta, pret, pret.HasValue ? oferta * pret.Value : null);
                })
                .OrderByDescending(g => g.NecesarMl)
                .ToList();
        }
    }

    private record AlertaMaterial(string Mesaj, Severity Severitate);

    private List<AlertaMaterial> AlerteMateriale
    {
        get
        {
            var alerte = new List<AlertaMaterial>();

            if (PieseFaraMaterial > 0)
            {
                alerte.Add(new($"{PieseFaraMaterial} piese nu au material selectat. Verifică în tab-ul Piese.", Severity.Warning));
            }

            foreach (var calcul in (_calcule ?? new List<CalculMaterialDto>()).Where(c => !string.IsNullOrWhiteSpace(c.Erori)))
            {
                alerte.Add(new($"{calcul.MaterialNume}: {calcul.Erori}", Severity.Error));
            }

            if ((_calcule ?? new List<CalculMaterialDto>()).Any(c => c.Status == StatusCalculMaterial.NecesitaRecalculare))
            {
                alerte.Add(new("Lista pieselor a fost modificată. Recalculează materialele.", Severity.Info));
            }

            return alerte;
        }
    }

