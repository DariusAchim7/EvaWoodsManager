        {
            if (_proiect is null || _proiect.Valoare <= 0) return "0";
            return (TotalCheltuieli / _proiect.Valoare * 100).ToString("0.#");
        }
    }

    private decimal TotalMateriale => SumaPeCategorie(CategorieCheltuiala.Materiale);
    private decimal TotalServicii => SumaPeCategorie(CategorieCheltuiala.Servicii);
    private decimal TotalAlteCheltuieli => SumaPeCategorie(CategorieCheltuiala.AlteCheltuieli);

    private decimal SumaPeCategorie(CategorieCheltuiala categorie) =>
        _cheltuieli?.Where(c => c.Status == StatusCheltuiala.Confirmata && c.Categorie == categorie).Sum(c => c.Total) ?? 0;

    private string ProcentMateriale => ProcentDinTotalCheltuieli(TotalMateriale);
    private string ProcentServicii => ProcentDinTotalCheltuieli(TotalServicii);
    private string ProcentAlteCheltuieli => ProcentDinTotalCheltuieli(TotalAlteCheltuieli);

    private string ProcentDinTotalCheltuieli(decimal suma)
    {
        if (TotalCheltuieli <= 0) return "0";
        return (suma / TotalCheltuieli * 100).ToString("0.#");
    }

