    private List<(string Mesaj, Severitate Severitate)> AlerteCheltuieliTab
    {
        get
        {
            var alerte = new List<(string, Severitate)>();

            if (ProcentConsumat.HasValue)
            {
                if (ProcentConsumat.Value > 100)
                {
                    alerte.Add(($"Cheltuielile au depășit bugetul alocat cu {ProcentConsumat.Value - 100:0.#}%.", Severitate.Critica));
                }
                else if (ProcentConsumat.Value >= 85)
                {
                    alerte.Add(($"Cheltuielile au depășit {ProcentConsumat.Value:0.#}% din bugetul alocat.", Severitate.Atentionare));
                }
            }

            var facturiDuplicate = (_cheltuieli ?? new List<CheltuialaDto>())
                .Where(c => !string.IsNullOrWhiteSpace(c.NumarFactura))
                .GroupBy(c => c.NumarFactura)
                .Where(g => g.Count() > 1);

            foreach (var grup in facturiDuplicate)
            {
                alerte.Add(($"Numărul de factură „{grup.Key}\" apare de {grup.Count()} ori.", Severitate.Atentionare));
            }

            var numarCiorne = (_cheltuieli ?? new List<CheltuialaDto>()).Count(c => c.Status == StatusCheltuiala.Ciorna);
            if (numarCiorne > 0)
            {
                alerte.Add(($"{numarCiorne} cheltuieli neconfirmate (ciorne) așteaptă revizuire.", Severitate.Info));
            }

            return alerte;
        }
    }

