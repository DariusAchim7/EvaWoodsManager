    private bool FiltruCheltuieli(CheltuialaDto c)
    {
        if (!string.IsNullOrWhiteSpace(_cautareCheltuieli))
        {
            var termen = _cautareCheltuieli.Trim();
            var gasit = c.Descriere.Contains(termen, StringComparison.OrdinalIgnoreCase)
                || (c.FurnizorNume?.Contains(termen, StringComparison.OrdinalIgnoreCase) ?? false)
                || (c.NumarFactura?.Contains(termen, StringComparison.OrdinalIgnoreCase) ?? false)
                || NumeCategorieScurt(c.Categorie).Contains(termen, StringComparison.OrdinalIgnoreCase)
                || c.Total.ToString("0.##").Contains(termen, StringComparison.OrdinalIgnoreCase);

            if (!gasit) return false;
        }

        if (_filtruCategorie.HasValue && c.Categorie != _filtruCategorie.Value) return false;
        if (_filtruFurnizorId.HasValue && c.FurnizorId != _filtruFurnizorId.Value) return false;

        if (!string.IsNullOrWhiteSpace(_filtruStatus))
        {
            var potriveste = _filtruStatus switch
            {
                "Ciorna" => c.Status == StatusCheltuiala.Ciorna,
                "Platita" => c.Status == StatusCheltuiala.Confirmata && c.StatusPlata == StatusPlata.Platita,
                "InAsteptare" => c.Status == StatusCheltuiala.Confirmata && c.StatusPlata == StatusPlata.InAsteptare,
                _ => true
            };
            if (!potriveste) return false;
        }

        if (_filtruDataDeLa.HasValue && c.Data.Date < _filtruDataDeLa.Value.Date) return false;
        if (_filtruDataPanaLa.HasValue && c.Data.Date > _filtruDataPanaLa.Value.Date) return false;

        if (_filtruAreTva.HasValue)
        {
            var areTva = c.Tva > 0;
            if (areTva != _filtruAreTva.Value) return false;
        }

        if (_filtruAreFactura.HasValue)
        {
            var areFactura = !string.IsNullOrWhiteSpace(c.NumarFactura);
            if (areFactura != _filtruAreFactura.Value) return false;
        }

        if (_filtruMetodaPlata.HasValue && c.MetodaPlata != _filtruMetodaPlata.Value) return false;

        return true;
    }

