@using EvaWoods.Application.Piese
@using EvaWoods.Application.Produse
@using EvaWoods.Domain.Piese
@using EvaWoods.Domain.Produse
@using System.Text.RegularExpressions
@inject IPiesaService PiesaService
@inject IProdusService ProdusService

<MudDialog Class="piese-dialog-lat">
    <DialogContent>
        @* ---------- Material + Material cant: alese o singură dată ---------- *@
        <MudGrid Class="mb-1">
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid?" @bind-Value="_materialId" Label="Material" Margin="Margin.Dense" Required="true">
                    @foreach (var material in _materiale)
                    {
                        <MudSelectItem T="Guid?" Value="material.Id">@material.Nume</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid?" @bind-Value="_materialCantId" Label="Material cant" Clearable="true" Margin="Margin.Dense">
                    @foreach (var cant in _materialeCant)
                    {
                        <MudSelectItem T="Guid?" Value="cant.Id">@cant.Nume</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        @if (MaterialSelectat is not null)
        {
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mb-3">
                @if (MaterialSelectat.GrosimeMm.HasValue)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Grosime @MaterialSelectat.GrosimeMm.Value.ToString("0.##") mm</MudChip>
                }
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                    @(MaterialSelectat.PermiteRotire ? "Rotire permisă" : "Fără rotire")
                </MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                    @(MaterialSelectat.AreFibra ? "Cu fibră — pe lungimea piesei" : "Fără fibră")
                </MudChip>
            </MudStack>
        }
        else
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                Alege materialul o singură dată; toate piesele de mai jos îl vor folosi. Grosimea, rotirea și fibra se iau automat din material.
            </MudText>
        }

        <MudExpansionPanels Elevation="0" Class="mb-3">
            <MudExpansionPanel Text="Adăugare rapidă (500x300=2, câte una pe linie)">
                <MudTextField T="string" @bind-Value="_textRapid" Lines="5" Immediate="true"
                              Placeholder="500x300=2&#10;720x560=2&#10;800x560=1" />
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-2">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Format: lungime x lățime = cantitate. Rândurile generate se completează apoi cu cantul mai jos.
                    </MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="GenereazaDinTextRapid">
                        Generează rânduri
                    </MudButton>
                </MudStack>
                @if (_eroareTextRapid is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_eroareTextRapid</MudAlert>
                }
            </MudExpansionPanel>
        </MudExpansionPanels>

        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">
            Un rând nou apare automat când completezi dimensiunile pe ultimul rând.
        </MudText>

        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; min-width: 640px;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--mud-palette-lines-default);">
                        <th style="min-width: 95px; text-align: left;"><MudText Typo="Typo.caption">Lungime</MudText></th>
                        <th style="min-width: 95px; text-align: left;"><MudText Typo="Typo.caption">Lățime</MudText></th>
                        <th style="min-width: 75px; text-align: left;"><MudText Typo="Typo.caption">Buc</MudText></th>
                        <th style="min-width: 160px; text-align: left;"><MudText Typo="Typo.caption">Cant</MudText></th>
                        <th style="min-width: 85px; text-align: right;"><MudText Typo="Typo.caption">Total cant</MudText></th>
                        <th style="width: 80px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rand in _randuri)
                    {
                        <tr style="border-bottom: 1px solid var(--mud-palette-lines-default);">
                            <td>
                                <MudNumericField T="decimal?" @bind-Value="rand.Lungime" Margin="Margin.Dense" Min="0m" HideSpinButtons="true"
                                                  @bind-Value:after="VerificaRandNou" />
                            </td>
                            <td>
                                <MudNumericField T="decimal?" @bind-Value="rand.Latime" Margin="Margin.Dense" Min="0m" HideSpinButtons="true"
                                                  @bind-Value:after="VerificaRandNou" />
                            </td>
                            <td>
                                <MudNumericField T="int?" @bind-Value="rand.Cantitate" Margin="Margin.Dense" Min="1" HideSpinButtons="true" />
                            </td>
                            <td>
                                @if (EstePatrata(rand))
                                {
                                    <MudSelect T="int" @bind-Value="rand.TotalCantPatrat" Margin="Margin.Dense" Label="Total (0-4)">
                                        <MudSelectItem T="int" Value="0">0</MudSelectItem>
                                        <MudSelectItem T="int" Value="1">1</MudSelectItem>
                                        <MudSelectItem T="int" Value="2">2</MudSelectItem>
                                        <MudSelectItem T="int" Value="3">3</MudSelectItem>
                                        <MudSelectItem T="int" Value="4">4</MudSelectItem>
                                    </MudSelect>
                                }
                                else
                                {
                                    <MudStack Row="true" Spacing="1">
                                        <MudSelect T="int" @bind-Value="rand.CantLungi" Margin="Margin.Dense" Label="L" Style="min-width: 60px;">
                                            <MudSelectItem T="int" Value="0">0</MudSelectItem>
                                            <MudSelectItem T="int" Value="1">1</MudSelectItem>
                                            <MudSelectItem T="int" Value="2">2</MudSelectItem>
                                        </MudSelect>
                                        <MudSelect T="int" @bind-Value="rand.CantScurte" Margin="Margin.Dense" Label="S" Style="min-width: 60px;">
                                            <MudSelectItem T="int" Value="0">0</MudSelectItem>
                                            <MudSelectItem T="int" Value="1">1</MudSelectItem>
                                            <MudSelectItem T="int" Value="2">2</MudSelectItem>
                                        </MudSelect>
                                    </MudStack>
                                }
                            </td>
                            <td style="text-align: right;">
                                <MudText Typo="Typo.caption">@TotalCantRand(rand)</MudText>
                            </td>
                            <td>
                                <MudStack Row="true" Spacing="0">
                                    <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" OnClick="@(() => DuplicaRand(rand))" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" OnClick="@(() => StergeRand(rand))" />
                                </MudStack>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_eroareSalvare is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_eroareSalvare</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Anuleaza">Anulează</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SalveazaToate" Disabled="_seSalveaza">
            Salvează toate (@_randuri.Count(RandValid) piese)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid ProiectId { get; set; }

    private readonly List<RandPiesa> _randuri = new() { new RandPiesa() };
    private List<ProdusDto> _materiale = new();
    private List<ProdusDto> _materialeCant = new();

    private Guid? _materialId;
    private Guid? _materialCantId;

    private string _textRapid = string.Empty;
    private string? _eroareTextRapid;
    private string? _eroareSalvare;
    private bool _seSalveaza;

    private ProdusDto? MaterialSelectat =>
        _materialId.HasValue ? _materiale.FirstOrDefault(m => m.Id == _materialId.Value) : null;

    protected override async Task OnInitializedAsync()
    {
        var produse = await ProdusService.ObtineToateProduseleAsync();
        _materiale = produse.Where(p => p.EsteActiv && p.Categorie == CategorieProdus.Materiale).ToList();
        _materialeCant = produse.Where(p => p.EsteActiv && p.Categorie == CategorieProdus.Consumabile).ToList();
    }

    private static bool EstePatrata(RandPiesa rand) =>
        rand.Lungime is > 0 && rand.Latime is > 0 && rand.Lungime == rand.Latime;

    private static bool RandGol(RandPiesa rand) =>
        rand.Lungime is null && rand.Latime is null;

    private static bool RandValid(RandPiesa rand) =>
        rand.Lungime is > 0 && rand.Latime is > 0 && rand.Cantitate is >= 1;

    private void VerificaRandNou()
    {
        var ultimul = _randuri.LastOrDefault();
        if (ultimul is not null && ultimul.Lungime is > 0 && ultimul.Latime is > 0)
        {
            _randuri.Add(new RandPiesa());
        }
    }

    private void GenereazaDinTextRapid()
    {
        _eroareTextRapid = null;
        var linii = _textRapid.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var regex = new Regex(@"^(\d+(?:[.,]\d+)?)\s*[xX*]\s*(\d+(?:[.,]\d+)?)\s*=\s*(\d+)$");
        var liniiInvalide = new List<string>();

        foreach (var linie in linii)
        {
            var potrivire = regex.Match(linie);
            if (!potrivire.Success)
            {
                liniiInvalide.Add(linie);
                continue;
            }

            var lungime = decimal.Parse(potrivire.Groups[1].Value.Replace(',', '.'), System.Globalization.CultureInfo.InvariantCulture);
            var latime = decimal.Parse(potrivire.Groups[2].Value.Replace(',', '.'), System.Globalization.CultureInfo.InvariantCulture);
            var cantitate = int.Parse(potrivire.Groups[3].Value);

            var randGol = _randuri.FirstOrDefault(RandGol);
            var rand = randGol ?? new RandPiesa();
            rand.Lungime = lungime;
            rand.Latime = latime;
            rand.Cantitate = cantitate;

            if (randGol is null)
            {
                _randuri.Add(rand);
            }
        }

        if (liniiInvalide.Count > 0)
        {
            _eroareTextRapid = $"Linii ignorate (format invalid): {string.Join("; ", liniiInvalide)}";
        }
        else
        {
            _textRapid = string.Empty;
        }

        VerificaRandNou();
    }

    private void DuplicaRand(RandPiesa rand)
    {
        var index = _randuri.IndexOf(rand);
        _randuri.Insert(index + 1, new RandPiesa
        {
            Lungime = rand.Lungime,
            Latime = rand.Latime,
            Cantitate = rand.Cantitate,
            CantLungi = rand.CantLungi,
            CantScurte = rand.CantScurte,
            TotalCantPatrat = rand.TotalCantPatrat
        });
    }

    private void StergeRand(RandPiesa rand)
    {
        _randuri.Remove(rand);
        if (_randuri.Count == 0)
        {
            _randuri.Add(new RandPiesa());
        }
    }

    private string TotalCantRand(RandPiesa rand)
    {
        if (!RandValid(rand)) return "-";

        var (lungi, scurte) = CantEfectiv(rand);
        if (lungi == 0 && scurte == 0) return "-";

        var total = (lungi * (rand.Lungime!.Value + 40m) + scurte * (rand.Latime!.Value + 40m)) * rand.Cantitate!.Value / 1000m;
        return $"{total:0.##} ml";
    }

    private static (int Lungi, int Scurte) CantEfectiv(RandPiesa rand)
    {
        if (EstePatrata(rand))
        {
            var lungi = Math.Min(2, rand.TotalCantPatrat);
            return (lungi, rand.TotalCantPatrat - lungi);
        }

        return (rand.CantLungi, rand.CantScurte);
    }

    private async Task SalveazaToate()
    {
        _eroareSalvare = null;

        var material = MaterialSelectat;
        if (material is null)
        {
            _eroareSalvare = "Alege materialul înainte de salvare.";
            return;
        }

        var valide = _randuri.Where(RandValid).ToList();

        if (valide.Count == 0)
        {
            _eroareSalvare = "Niciun rând valid de salvat. Completează cel puțin lungimea, lățimea și cantitatea.";
            return;
        }

        var incomplete = _randuri.Where(r => !RandGol(r) && !RandValid(r)).ToList();
        if (incomplete.Count > 0)
        {
            _eroareSalvare = $"{incomplete.Count} rânduri au date incomplete (dimensiuni > 0 și cantitate ≥ 1 obligatorii). Completează-le sau șterge-le.";
            return;
        }

        _seSalveaza = true;

        // Grosimea, rotirea și fibra vin automat din material.
        // Fibra e mereu pe lungimea piesei; optimizatorul nu rotește piesele cu fibră.
        var fibra = material.AreFibra ? DirectieFibra.Verticala : DirectieFibra.Fara;

        var requests = valide.Select(rand =>
        {
            var (lungi, scurte) = CantEfectiv(rand);
            return new CreeazaPiesaRequest(
                ProiectId: ProiectId,
                LungimeMm: rand.Lungime!.Value,
                LatimeMm: rand.Latime!.Value,
                Cantitate: rand.Cantitate!.Value,
                MaterialProdusId: material.Id,
                GrosimeMm: material.GrosimeMm,
                CantLaturiLungi: lungi,
                CantLaturiScurte: scurte,
                MaterialCantProdusId: _materialCantId,
                DirectieFibra: fibra,
                PermiteRotire: material.PermiteRotire);
        }).ToList();

        await PiesaService.AdaugaPieseAsync(requests);

        _seSalveaza = false;
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Anuleaza() => MudDialog.Cancel();

    private class RandPiesa
    {
        public decimal? Lungime { get; set; }
        public decimal? Latime { get; set; }
        public int? Cantitate { get; set; } = 1;
        public int CantLungi { get; set; }
        public int CantScurte { get; set; }
        public int TotalCantPatrat { get; set; }
    }
}
