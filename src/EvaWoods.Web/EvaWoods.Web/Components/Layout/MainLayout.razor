@inherits LayoutComponentBase
@using EvaWoods.Web.Theme

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Edge="Edge.Start"
                       Class="mr-2"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6">Bună ziua, Darius! 👋</MudText>
        <MudSpacer />
        <MudTextField T="string" Placeholder="Caută proiecte, clienți, documente..."
                       Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                       Margin="Margin.Dense" Variant="Variant.Outlined"
                       Style="max-width: 340px;" Class="mr-4 d-none d-md-flex" />
        <MudBadge Content="3" Color="Color.Error" Overlap="true" Class="mr-4">
            <MudIconButton Icon="@Icons.Material.Filled.Notifications" />
        </MudBadge>
        <MudIconButton Icon="@Icons.Material.Filled.LightMode" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Elevation="0"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pa-3 pa-md-6">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    private readonly EvaWoodsTheme _theme = new();

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
